    "dependency-graph": "1.0.0",
    "es-hangul": "2.4.0",
    "excel-formula-tokenizer": "3.0.0",
    "exceljs": "4.4.0",
    "fast-json-stable-stringify": "2.1.0",
    "minisearch": "7.2.0",
    "p-map": "7.0.4",
    "p-retry": "8.0.1",
    "proper-lockfile": "4.1.2",
    "quickjs-emscripten-core": "0.32.0"
  },
  "devDependencies": {
    "@e2e/cx-design-system": "file:../../extensions/aipro-chat/vendor/e2e-cx-design-system-0.5.4.tgz",
    "@ironcalc/nodejs": "0.8.3",
    "@jitl/quickjs-wasmfile-debug-sync": "0.32.0",
    "@testing-library/react": "16.3.3",
    "axe-core": "4.13.0",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "fflate": "0.8.3",
    "jsdom": "27.4.0",
    "patch-package": "8.0.1",
    "playwright": "1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
