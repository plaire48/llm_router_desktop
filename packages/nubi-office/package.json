{
  "name": "nubi-office",
  "version": "0.8.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:browser": "node tests/browser-release.mjs",
    "design:check": "node scripts/check-ui-parity.mjs && node ../../extensions/aipro-chat/node_modules/@e2e/cx-design-system/scripts/check.mjs src",
    "package": "node scripts/package.mjs",
    "postinstall": "patch-package --error-on-fail",
    "pretest": "patch-package --error-on-fail",
    "prebuild": "patch-package --error-on-fail",
    "test:visual": "node tests/ui-preview.mjs",
    "test:pinned": "node --import ./scripts/pinned-runtime-loader.mjs --test --test-concurrency=1 tests/*.test.mjs",
    "pretest:pinned": "patch-package --error-on-fail"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.86.1",
    "@earendil-works/pi-ai": "0.86.1",
