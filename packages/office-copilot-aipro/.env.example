# Independent credentials for this single-user pilot. Never paste secrets into Copilot.
PORT=8789
# HTTPS reverse proxy URL reachable by Microsoft, without a path.
PUBLIC_ORIGIN=
# Entra app exposing delegated scope access_as_user; request v2 access tokens.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Only this user's Entra object ID may use the configured AI Pro account.
ENTRA_ALLOWED_USER_ID=

# cli or browser-token. The two modes do not share credentials.
AIPRO_MODE=cli
AIPRO_CLI_BASE_URL=
AIPRO_CLI_TOKEN=
AIPRO_CLI_MODEL_ID=
# browser-token: separately provisioned AI Pro SSO JWT; no automatic login/refresh.
AIPRO_ACCESS_TOKEN=
AIPRO_MODEL_ID=

# Required only when producing the installable M365 package.
M365_APP_ID=
M365_OAUTH_REGISTRATION_ID=
M365_DEVELOPER_NAME=
M365_WEBSITE_URL=
M365_PRIVACY_URL=
M365_TERMS_URL=
