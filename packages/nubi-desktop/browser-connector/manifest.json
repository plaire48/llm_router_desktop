{
  "manifest_version": 3,
  "name": "누비 브라우저 연결",
  "version": "0.1.0",
  "description": "열린 브라우저 탭을 누비 Workspace의 기존 에이전트에 연결합니다.",
  "minimum_chrome_version": "125",
  "permissions": ["activeTab", "tabs", "debugger", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "connect.html", "default_title": "누비에 연결"},
  "icons": {"128": "nubi.png"}
}
