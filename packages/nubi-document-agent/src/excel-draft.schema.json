{
  "type":"object","additionalProperties":false,"required":["title","sheets"],
  "properties":{
    "title":{"type":"string","minLength":1,"maxLength":160},
    "sheets":{"type":"array","minItems":1,"maxItems":8,"items":{
      "type":"object","additionalProperties":false,"required":["name","columnWidths","rows"],
      "properties":{
        "name":{"type":"string","minLength":1,"maxLength":31},
        "columnWidths":{"type":"array","minItems":1,"maxItems":20,"items":{"type":"number","minimum":10,"maximum":65}},
        "rows":{"type":"array","minItems":1,"maxItems":400,"items":{"type":"array","minItems":0,"maxItems":20,"items":{
          "type":"object","additionalProperties":false,"required":["value","formula","format","role"],
          "properties":{
            "value":{"type":["string","number","boolean","null"],"maxLength":500},
            "formula":{"type":["string","null"],"maxLength":8192},
            "format":{"type":"string","enum":["general","integer","percent","date","decimal"]},
            "role":{"type":"string","enum":["body","title","header","input","total"]}
          }
        }}}
      }
    }}
  }
}
