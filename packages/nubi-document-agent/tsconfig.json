{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": "dist/types",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@genoffice/agent-core/redact-range": [
        "vendor/genoffice/packages/agent-core/src/redact-range.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "vendor/genoffice/packages/agent-core/src/*.ts"
  ]
}
